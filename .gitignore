# Guanlan / Node.js / Vite / Cloudflare
# Includes the rule from Paperphone-plus:
# https://github.com/619dev/Paperphone-plus/blob/main/.gitignore

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.dev.vars
/.dev.vars.*
!/.dev.vars.example
/outputs/
/work/

# editor and local tooling
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# caches and temporary files
/.cache/
/.turbo/
*.tsbuildinfo
*.log
*.tmp
